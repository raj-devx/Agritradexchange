# Copy to .env for local development.
# Production uses Prisma Postgres (set via Vercel integration).
# For local dev, point to any Postgres instance:
DATABASE_URL="postgresql://user:password@localhost:5432/agritradexchange?schema=public"

# Passcode for the /admin dashboard. Set a strong value in any real deployment.
ADMIN_PASSWORD="change-me"

# Passcode for the /agent field-agent workspace (separate role).
AGENT_PASSWORD="change-me-too"
