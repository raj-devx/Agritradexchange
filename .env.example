# Copy to .env for local development.
# Dev uses SQLite (zero setup). For production, use a Postgres URL, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/agritradexchange?schema=public"
# and change the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Passcode for the /admin dashboard. Set a strong value in any real deployment.
ADMIN_PASSWORD="change-me"

# Passcode for the /agent field-agent workspace (separate role).
AGENT_PASSWORD="change-me-too"
